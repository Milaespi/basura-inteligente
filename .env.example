# ── MongoDB ──────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://admin:<db_password>@cluster0.h8elraf.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=yoloDB

# ── JWT ──────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Aplicación ───────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
# Orígenes permitidos para el frontend (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Archivos ─────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=10
